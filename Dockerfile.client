# Build Stage
FROM node:18-alpine AS build

# Shared folder setup
WORKDIR /app/shared
COPY ./shared/ ./

# Client setup
WORKDIR /app/client
COPY ./client/package*.json ./
RUN npm ci
COPY ./client .
RUN npm run build

# Production Stage
FROM nginx:stable-alpine

# Serve static files from build
COPY --from=build /app/client/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]